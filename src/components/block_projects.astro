<script>
	document.addEventListener('DOMContentLoaded', () => {
	const section = document.querySelector('.projects') as HTMLElement;
	if (!section) return;

	const track = section.querySelector('.carousel__track--multiline') as HTMLElement;
	const cards = section.querySelectorAll('.carousel__item'); 
	const prevBtn = section.querySelector('.carousel__nav-btn[aria-label="Previous slide"]') as HTMLButtonElement;
	const nextBtn = section.querySelector('.carousel__nav-btn[aria-label="Next slide"]') as HTMLButtonElement;
	const indicatorsContainer = section.querySelector('.carousel__indicators') as HTMLElement;

	if (!track || cards.length === 0 || !indicatorsContainer) return;

	function getGridConfig() {
		const width = window.innerWidth;
		if (width >= 1024) return { cols: 3, rows: 2 }; // Desktop
		if (width >= 640) return { cols: 2, rows: 2 };  // Tablet
		return { cols: 1, rows: 1 };                    // Mobile
	}

	function layoutGrid() {
		const { cols, rows } = getGridConfig();
		cards.forEach((card, index) => {
			const page = Math.floor(index / (cols * rows));
			const indexOnPage = index % (cols * rows);
			const row = Math.floor(indexOnPage / cols) + 1;
			const col = (page * cols) + (indexOnPage % cols) + 1;

			const el = card as HTMLElement;
			el.style.gridRow = row.toString();
			el.style.gridColumn = col.toString();
		});
	}

	let currentIndex = 0; 
	let maxIndex = 0;
	let autoSlideTimer: ReturnType<typeof setInterval>;

	function updateSlider() {
		const { cols: visibleColumns, rows } = getGridConfig();
		const totalColumns = Math.ceil(cards.length / rows);
		
		maxIndex = Math.max(0, totalColumns - visibleColumns);

		if (currentIndex > maxIndex) currentIndex = maxIndex;
		if (currentIndex < 0) currentIndex = 0;

		const cardWidth = (cards[0] as HTMLElement).offsetWidth;
		const step = cardWidth + 40; // 40px gap

		track.style.transform = `translateX(-${currentIndex * step}px)`;

		// Now that we slide by 1, the total number of positions is maxIndex + 1
		// (e.g. if maxIndex is 0, we have 1 position. If maxIndex is 2, we have 3 positions).
		const totalSteps = maxIndex + 1;
		
		if (indicatorsContainer.children.length !== totalSteps) {
			indicatorsContainer.innerHTML = '';
			
			for (let i = 0; i < totalSteps; i++) {
				const slash = document.createElement('button');
				slash.type = 'button';
				slash.className = 'carousel__indicator';
				slash.textContent = '/';
				slash.setAttribute('aria-label', `Go to slide ${i + 1}`);
				slash.addEventListener('click', () => {
					currentIndex = i; // Jump exactly to this column step
					updateSlider();
					startAutoSlide();
				});
				indicatorsContainer.appendChild(slash);
			}
		}

		// Highlight active slash based on exact currentIndex
		Array.from(indicatorsContainer.children).forEach((slash, index) => {
			if (index === currentIndex) {
				slash.classList.add('carousel__indicator--active');
			} else {
				slash.classList.remove('carousel__indicator--active');
			}
		});

		if (prevBtn) {
			prevBtn.style.opacity = currentIndex === 0 ? '0.3' : '1';
			prevBtn.style.cursor = currentIndex === 0 ? 'default' : 'pointer';
		}
		if (nextBtn) {
			nextBtn.style.opacity = currentIndex >= maxIndex ? '0.3' : '1';
			nextBtn.style.cursor = currentIndex >= maxIndex ? 'default' : 'pointer';
		}
	}

	function startAutoSlide() {
		clearInterval(autoSlideTimer);
		if (maxIndex <= 0) return; 

		autoSlideTimer = setInterval(() => {
			if (currentIndex >= maxIndex) {
				currentIndex = 0;
			} else {
				currentIndex += 1; // SLIDE BY 1 COLUMN
				if (currentIndex > maxIndex) currentIndex = maxIndex;
			}
			updateSlider();
		}, 8500);
	}

	prevBtn?.addEventListener('click', () => {
		if (currentIndex > 0) {
			currentIndex -= 1; // SLIDE BY 1 COLUMN
			if (currentIndex < 0) currentIndex = 0;
			updateSlider();
			startAutoSlide();
		}
	});

	nextBtn?.addEventListener('click', () => {
		if (currentIndex < maxIndex) {
			currentIndex += 1; // SLIDE BY 1 COLUMN
			if (currentIndex > maxIndex) currentIndex = maxIndex;
			updateSlider();
			startAutoSlide();
		}
	});

	// Pause on hover
	track.addEventListener('mouseenter', () => clearInterval(autoSlideTimer));
	track.addEventListener('mouseleave', startAutoSlide);

	window.addEventListener('resize', () => {
		layoutGrid();
		updateSlider();
	});
	
	setTimeout(() => {
		layoutGrid();
		updateSlider();
		startAutoSlide();
	}, 0);
});
</script>