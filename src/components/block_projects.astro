<script>
	// Projects slider: identical system to the services slider, but the
	// sliding UNIT is a COLUMN (two stacked cards). One column per click,
	// stop + disable arrows at the ends, autoplay pages by perView columns.
	// Column boxes range 340..400px, sized from the viewport exactly like
	// the services card boxes; the 40px gutter comes from the cards' px-5.
	// The indicator keeps ONE SLASH PER CARD: each seen column fills the
	// slashes of all its cards (normally two at a time).
	const BOX_MIN = 340;      // column (flex item) min width
	const BOX_MAX = 400;      // column max width
	const MAX_PER_VIEW = 3;   // never show more than 3 columns at once
	const AUTOPLAY_MS = 5000; // idle time before auto-sliding one full page

	function initProjectsSlider(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-track]');
		const viewport = root.querySelector<HTMLElement>('[data-slider-col]');
		const columns = Array.from(root.querySelectorAll<HTMLElement>('[data-column]'));
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
		const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
		if (!track || !viewport || !columns.length || !prevBtn || !nextBtn) return;

		// cards per column (last column may hold a single card on odd totals)
		const colCardCounts = columns.map((c) => c.querySelectorAll('[data-slide]').length);

		// progress indicator: one slash per CARD
		const FILLED = '#FF8C00';
		const EMPTY = '#cccccc';
		const indicator = root.querySelector<HTMLElement>('[data-indicator]');
		const marksBox = root.querySelector<HTMLElement>('[data-indicator-marks]') ?? indicator;
		const countEl = root.querySelector<HTMLElement>('[data-indicator-count]');
		const marks: HTMLElement[] = [];
		if (marksBox) {
			marksBox.textContent = '';
			for (let i = 0; i < slides.length; i++) {
				const m = document.createElement('span');
				m.textContent = '/';
				m.style.color = EMPTY;
				marksBox.appendChild(m);
				marks.push(m);
			}
		}

		let index = 0;    // in COLUMNS
		let perView = 1;  // columns visible
		let box = BOX_MIN;
		let padLeft = 0;

		function paintIndicator() {
			// seen cards = all cards inside on-screen or already-passed columns
			const seenCols = Math.min(columns.length, index + perView);
			let filled = 0;
			for (let i = 0; i < seenCols; i++) filled += colCardCounts[i];
			filled = Math.min(slides.length, filled);
			for (let i = 0; i < marks.length; i++) {
				marks[i].style.color = i < filled ? FILLED : EMPTY;
			}
			if (countEl) countEl.textContent = String(filled).padStart(2, '0');
		}

		function layout() {
			const vw = viewport.clientWidth;
			let n = Math.floor(vw / BOX_MIN);
			n = Math.max(1, Math.min(MAX_PER_VIEW, n, columns.length));
			let b = Math.max(BOX_MIN, Math.min(BOX_MAX, vw / n));
			const leftover = Math.max(0, vw - n * b);

			perView = n;
			box = b;
			padLeft = leftover / 2;

			for (const c of columns) {
				c.style.flex = `0 0 ${b}px`;
				c.style.width = `${b}px`;
				c.style.maxWidth = `${b}px`;
			}
		}

		function maxIndex() {
			return Math.max(0, columns.length - perView);
		}

		function apply() {
			const max = maxIndex();
			index = Math.min(Math.max(index, 0), max);
			const x = padLeft - index * box;
			track.style.transform = `translate3d(${x}px, 0, 0)`;
			prevBtn.disabled = index <= 0;
			nextBtn.disabled = index >= max;
			paintIndicator();
		}

		function update() { layout(); apply(); }

		// autoplay: pages by perView columns, wraps at the end; manual arrows
		// still stop. Same guards as services: hover, hidden tab, reduced motion.
		let autoTimer = 0;
		let hovered = false;
		const reducedMotion = !!(window.matchMedia
			&& window.matchMedia('(prefers-reduced-motion: reduce)').matches);

		function autoAdvance() {
			const max = maxIndex();
			if (max <= 0) return;
			index = index >= max ? 0 : Math.min(index + perView, max);
			apply();
		}

		function stopAutoplay() {
			if (autoTimer) { clearInterval(autoTimer); autoTimer = 0; }
		}

		function startAutoplay() {
			stopAutoplay();
			if (reducedMotion) return;
			autoTimer = window.setInterval(() => {
				if (hovered || document.hidden) return;
				autoAdvance();
			}, AUTOPLAY_MS);
		}

		viewport.addEventListener('mouseenter', () => { hovered = true; });
		viewport.addEventListener('mouseleave', () => { hovered = false; });

		prevBtn.addEventListener('click', () => { index -= 1; apply(); startAutoplay(); });
		nextBtn.addEventListener('click', () => { index += 1; apply(); startAutoplay(); });

		let raf = 0;
		const schedule = () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(update);
		};
		if (typeof ResizeObserver !== 'undefined') {
			new ResizeObserver(schedule).observe(viewport);
		} else {
			window.addEventListener('resize', schedule);
		}
		window.addEventListener('load', schedule);

		update();
		startAutoplay();
	}

	document.querySelectorAll<HTMLElement>('[data-slider-col]').forEach((el) => {
		const groupEl = (el.closest('.flex-wrap') as HTMLElement) ?? el.parentElement!;
		initProjectsSlider(groupEl);
	});
</script>