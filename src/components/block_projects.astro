---
// src/components/block_projects.astro
import ItemArrow from './item_arrow.astro';
---

<section class="mt-25 relative px-5">
	<div class="mx-auto flex flex-wrap justify-center gap-y-[40px] w-full max-w-[1600px]">

		<div class="p-5 min-[1420px]:h-[240px] self-start
		            flex-[1_1_100%] max-w-[400px]
		            min-[720px]:max-w-[800px]
		            min-[1080px]:max-w-[1200px]
		            min-[1420px]:flex-[1_1_340px] min-[1420px]:max-w-[400px]">
			<h3 id="projects" class="relative py-1 font-bold text-[24px] text-[#222222]">
				<span class="absolute -top-[20px] left-0 w-[40px] h-[10px] bg-[#FF8C00]"></span>
				PROJECTS & ACTIVITIES
			</h3>
			<p class="text-[16px] pt-5 text-black leading-[1.25]">
				We’ve helped to succesfully accomplished different projects.
			</p>
			<a href="#" aria-label="See all projects" class="mt-5 group inline-flex items-center gap-1.5
																	min-[1420px]:absolute
																	min-[1420px]:top-42">
				<span class="flex justify-center items-center leading-none w-[40px] h-[24px] rounded-[5px] border border-black bg-black text-white text-[15px] transition-colors duration-300 group-hover:bg-[#FF8C00] group-hover:border-[#FF8C00] group-hover:text-black">
					&rarr;
				</span>
				<span class="inline-flex items-center justify-center px-3 h-[24px] rounded-[5px] border border-black bg-transparent text-black text-[12px] transition-colors duration-300 group-hover:bg-black group-hover:text-white">
					&gt; see all_
				</span>
			</a>
		</div>

		<!-- COLUMN GROUP: a 2-row slider. Each column = two stacked cards;
		     the whole column slides as one unit. min-w-0 is REQUIRED (same
		     flexbox trap as the services slider: without it the non-wrapping
		     track forces this flex item wider than its container). -->
		<div class="flex flex-wrap gap-y-[40px] min-w-0
		            flex-[1_1_100%] max-w-[400px]
		            min-[720px]:max-w-[800px]
		            min-[1080px]:max-w-[1200px]
		            min-[1420px]:flex-[3_3_1020px] min-[1420px]:max-w-[1200px]">

			<!-- viewport: data-slider-col (NOT data-slider) so the services
			     script's global [data-slider] query never matches this one -->
			<div class="projects-slider w-full min-w-0 overflow-hidden" data-slider-col>
				<!-- track: non-wrapping row of COLUMNS; the 40px gutter between
				     columns comes from each card's own px-5, as everywhere else -->
				<div class="flex flex-nowrap transition-transform duration-300 ease-out will-change-transform"
				     data-track>

					<!-- COLUMN 1: cards 1 (top) + 4 (bottom) -->
					<div class="shrink-0 flex flex-col gap-y-[40px]" data-column>
						<div class="px-5 h-[240px] text-[#222222]" data-slide>
							<article class="group relative flex flex-col items-start w-full h-[240px] rounded-[24px] px-8 py-7
											bg-[url('/project1.png')] bg-center bg-cover bg-no-repeat">
								<div class="absolute inset-0 rounded-[24px] bg-[#FF8C00] opacity-0 transition-opacity duration-300 group-hover:opacity-100 z-0"></div>
								<div class="relative flex flex-row gap-2 mb-4 z-10">
								<div class="inline-flex items-center bg-black text-white text-[15px] font-bold px-4 h-[30px] rounded-full">BIM</div>
								<div class="inline-flex items-center bg-black text-white text-[15px] font-bold px-4 h-[30px] rounded-full">IT</div>
								<div class="inline-flex items-center bg-black text-white text-[15px] font-bold px-4 h-[30px] rounded-full">DEV</div>
								</div>
								<div class="relative flex-1 w-full z-10 flex flex-col">
									<div class="relative w-full flex-1">
										<div class="absolute inset-0 transition-opacity duration-300 opacity-100 group-hover:opacity-0 pointer-events-none">
											<div class="w-[180px] bg-black text-white px-4 py-3 rounded-[16px] flex flex-col self-start gap-1">
												<h3 class="text-[32px] font-extrabold tracking-wide leading-none">ABXYZ</h3>
												<p class="text-[16px] font-bold tracking-widest">#Y2K26</p>
											</div>
										</div>
										<p class="py-3 absolute inset-0 text-[16px] font-medium text-[#222222] leading-[1.25] transition-opacity duration-300 opacity-0 group-hover:opacity-100 pointer-events-none pr-8">
											We support ongoing projects by establishing and maintaining digital collaborative workflows among involved parties.
										</p>
									</div>
									<a href="#" class="inline-flex items-center bg-black text-white text-[12px] px-3 w-[80px] h-[24px] rounded-[5px] mt-auto z-10 self-start">
