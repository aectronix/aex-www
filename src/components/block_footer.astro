---
// src/components/block_footer.astro
import Logo from './aex_logo_bo.astro';
import LogoText from './aex_logo_text.astro';
import IcoLinkedin from './item_ico_linkedin.astro';
import IcoInstagram from './item_ico_instagram.astro';
import IcoGithub from './item_ico_github.astro';

const currentYear = new Date().getFullYear();
---

<footer class="relative mt-30 pt-20 pb-12 px-5 bg-[#222222]">
	<div class="mx-auto flex flex-wrap justify-center gap-y-[20px] w-full max-w-[1600px]">
		
		<div class="flex flex-col gap-3 self-start flex-[1_1_340px] max-w-[340px] md:max-w-[400px]">
			
			<div class="bg-[#FF8C00] rounded-[12px] p-5 h-[120px] flex gap-[30px]">
				<div class="flex flex-col justify-between w-[40px] h-full">
					<div class="w-[40px] h-[40px] text-[#222222] flex items-center justify-center">
						<Logo />
					</div>
					<div class="flex h-[24px] w-full justify-between items-center">
						<div class="w-[4px] bg-[#222222] h-3"></div>
						<div class="w-[2px] bg-[#222222] h-3"></div>
						<div class="w-[4px] bg-[#222222] h-3"></div>
						<div class="w-[6px] bg-[#222222] h-3"></div>
						<div class="w-[2px] bg-[#222222] h-3"></div>
						<div class="w-[4px] bg-[#222222] h-3"></div>
						<div class="w-[4px] bg-[#222222] h-3"></div>
						<div class="w-[2px] bg-[#222222] h-3"></div>
					</div>
				</div>
				<div class="flex-1 flex flex-col justify-between h-full">
					<div class="flex justify-between items-start">
						<div class="w-28 mt-1 text-[#222222]">
							<LogoText />
						</div>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5">
							<rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
							<line x1="8" y1="16" x2="16" y2="8"></line>
							<polyline points="8 8 16 8 16 16"></polyline>
						</svg>
					</div>
					<div class="border-b-[3px] border-[#222222] w-full"></div>
					<div class="flex flex-wrap gap-[6px] text-[13px] font-bold">
						<span class="h-[24px] inline-flex items-center bg-[#222222] text-[#FF8C00] px-2 rounded-[4px] border border-[#222222]">&lt;AEX&gt;</span>
						<span class="h-[24px] inline-flex items-center bg-[#222222] text-[#FF8C00] px-2 rounded-[4px] border border-[#222222]">IEx04</span>
						<span class="h-[24px] inline-flex items-center bg-transparent text-[#222222] px-2 rounded-[4px] border-2 border-[#222222] font-black">EST. Y2K23 /*</span>
					</div>
				</div>
			</div>

			<div class="flex items-center justify-between">
				<div class="bg-[#777777] rounded-[10px]  h-[48px] px-4 flex items-center gap-1">
					<span class="pl-1 font-black text-black text-[15px]">COM<span class=" font-mono text-[18px]">0</span></span>
						<a href="mailto:info@aectronix.com" class="ml-[23px] h-[24px] inline-flex items-center bg-[#181818] text-[#828282] font-bold transition-colors duration-300 text-[13px] px-2.5 rounded-[4px] hover:text-white hover:underline transition-colors">
							info@aectronix.com
						</a>
						<a href="mailto:info@aectronix.com" class="hidden md:inline-flex h-[24px] items-center bg-[#181818] text-[#828282] font-bold transition-colors duration-300 text-[13px] px-2.5 rounded-[4px] hover:text-white hover:underline  transition-colors">
							m
						</a>
				</div>
				<div class="relative flex gap-2 text-[#FF8C00]">
					<a href="#" aria-label="LinkedIn" class="hover:text-white transition-colors">
						<IcoLinkedin class="w-[24px] h-[24px]" />
					</a>
					<a href="#" aria-label="Instagram" class="hover:text-white transition-colors">
						<IcoInstagram class="w-[24px] h-[24px]" />
					</a>
					<a href="#" aria-label="GitHub" class="hover:text-white transition-colors">
						<IcoGithub class="w-[24px] h-[24px]" />
					</a>
				</div>
			</div>

		</div>

		<div class="flex flex-wrap gap-y-[20px]
				flex-[1_1_340px] max-w-[400px]
				min-[1080px]:flex-[2_2_680px] min-[1080px]:max-w-[800px]
				min-[1420px]:flex-[3_3_1020px] min-[1420px]:max-w-[1200px]">
			
			<div class="bg-[#252525] rounded-[12px] px-6 min-[420px]:px-12 py-4 h-[120px] text-white flex-[1_1_340px] max-w-[400px]">
				<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
					EXPLORE
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
						<line x1="7" y1="7" x2="17" y2="17"></line>
						<polyline points="17 7 17 17 7 17"></polyline>
					</svg>
				</h4>
				<div class="flex flex-wrap gap-2 mt-[10px]">
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] bg-[#FF8C00] !text-[#222222] font-bold text-[13px] hover:bg-white transition-colors duration-300">/home</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#000000] text-[13px] font-medium transition-colors duration-300">/services</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/projects</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/blog</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/dev</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/about</a>
				</div>
			</div>
			
			<div class="bg-[#252525] rounded-[12px] px-6 min-[420px]:px-12 py-4 h-[120px] text-white flex-[1_1_340px] max-w-[400px]">
				<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
					SERVICES
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
						<line x1="7" y1="7" x2="17" y2="17"></line>
						<polyline points="17 7 17 17 7 17"></polyline>
					</svg>
				</h4>
				<div class="flex flex-wrap gap-2 mt-[10px]">
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/bim</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/cde</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/ai</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/dev</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/it</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/bi</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/3dm</a>
					<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/aad</a>
				</div>
			</div>
			
			<div class="bg-[#252525] rounded-[12px] px-6 min-[420px]:px-12 py-4 h-[120px] text-white flex-[1_1_340px] max-w-[400px]">
					<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
						SUPPORT
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
							<line x1="7" y1="7" x2="17" y2="17"></line>
							<polyline points="17 7 17 17 7 17"></polyline>
						</svg>
					</h4>
					<div class="flex flex-wrap gap-2 mt-[10px]">
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/privacy policy</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/cookies</a>
					</div>
			</div>
			
		</div>



	</div>
	
	<div class="flex flex-wrap justify-center w-full mt-10">
		
		<div class="flex-[1_1_300px] max-w-[300px] min-[740px]:max-w-[400px] w-full flex items-center">
			<p class="text-[#555555] text-[12px] flex items-center gap-2 tracking-tight">
				<span class="w-[6px] h-[6px] ml-[2px] rounded-full bg-[#454545] inline-block"></span>
				<span>&nbsp;Copyright &copy; {currentYear} aectronix. All rights reserved.</span>
			</p>
		</div>
		
		<div class="flex-[1_1_340px] max-w-[40px] min-[740px]:max-w-[400px] min-[1080px]:flex-[2_2_680px] min-[1080px]:max-w-[800px] min-[1420px]:flex-[3_3_1020px] min-[1420px]:max-w-[1200px] w-full flex justify-end items-center">
			<p class="text-[#555555] text-[12px] italic tracking-wide">
				~1<span class="text-[14px]">y</span>//<span class="text-[#FF8C00]">/////</span>
			</p>
		</div>
		
	</div>

</footer>