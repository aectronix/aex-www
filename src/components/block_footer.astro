---
// src/components/block_footer.astro
import Logo from './aex_logo_bo.astro';
import LogoText from './aex_logo_text.astro';
import IcoLinkedin from './item_ico_linkedin.astro';
import IcoInstagram from './item_ico_instagram.astro';
import IcoGithub from './item_ico_github.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer relative pt-20 pb-12 bg-[#222222]">

	<div class="absolute top-0 left-0 w-full">
		<div class="container">
			<div class="grid grid-cols-1 min-[1760px]:grid-cols-4 gap-10">
				<div class="flex flex-col">
					<div class="h-[10px] w-[40px] bg-[var(--color-00-orange)]"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="container">
		
		<div class="grid grid-cols-1 min-[1760px]:grid-cols-4 gap-10">
			
			<div class="flex flex-col gap-4">
				
				<div class="h-[120px] bg-[var(--color-00-orange)] rounded-[12px] p-[20px] -mx-[20px] flex gap-[30px] text-[#222222]">
					
					<div class="flex flex-col justify-between w-[40px] h-full">
						<div class="w-[40px] h-[40px] text-[#222222] flex items-center justify-center">
							<Logo />
						</div>
						
						<div class="flex h-[24px] w-full justify-between items-center">
							<div class="w-[4px] bg-[#222222] h-3"></div>
							<div class="w-[2px] bg-[#222222] h-3"></div>
							<div class="w-[4px] bg-[#222222] h-3"></div>
							<div class="w-[6px] bg-[#222222] h-3"></div>
							<div class="w-[2px] bg-[#222222] h-3"></div>
							<div class="w-[4px] bg-[#222222] h-3"></div>
							<div class="w-[4px] bg-[#222222] h-3"></div>
							<div class="w-[2px] bg-[#222222] h-3"></div>
						</div>
					</div>

					<div class="flex-1 flex flex-col justify-between h-full">
						
						<div class="flex justify-between items-start">
							<div class="w-28 mt-1 text-[#222222]">
								<LogoText />
							</div>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5">
								<rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
								<line x1="8" y1="16" x2="16" y2="8"></line>
								<polyline points="8 8 16 8 16 16"></polyline>
							</svg>
						</div>
						
						<div class="border-b-[3px] border-[#222222] w-full"></div>
						
						<div class="flex flex-wrap gap-[6px] text-[13px] font-bold">
							<span class="h-[24px] inline-flex items-center bg-[#222222] text-[var(--color-00-orange)] px-2 rounded-[4px] border border-[#222222]">&lt;AEX&gt;</span>
							<span class="h-[24px] inline-flex items-center bg-[#222222] text-[var(--color-00-orange)] px-2 rounded-[4px] border border-[#222222]">IEx04</span>
							<span class="h-[24px] inline-flex items-center bg-transparent text-[#222222] px-2 rounded-[4px] border-2 border-[#222222] font-black">EST. Y2K23 /* ENV: PROD</span>
						</div>

					</div>

				</div>

				<div class="flex items-center gap-6">
					
					<div class="w-[276px] h-[48px] bg-[#828282] rounded-[12px] flex items-center -ml-[20px]">
						
						<div class="w-[90px] pl-[20px] flex items-center">
							<span class="font-black text-[#222222] text-[15px]">COM<span class=" font-mono text-[17px]">0</span></span>
						</div>
						
						<a href="mailto:info@aectronix.com" class="h-[24px] inline-flex items-center bg-[#222222] !text-[#828282] font-bold transition-colors duration-300 text-[13px] px-2.5 rounded-[6px]">
							&lt;info@aectronix.com&gt;
						</a>
					</div>

					<div class="flex items-center gap-2.5 mt-0.5">
						<a href="#" aria-label="LinkedIn" class="w-[24px] h-[24px] text-[var(--color-00-orange)] hover:text-white transition-colors duration-300 flex items-center justify-center">
							<IcoLinkedin />
						</a>
						<a href="#" aria-label="Instagram" class="w-[24px] h-[24px] text-[var(--color-00-orange)] hover:text-white transition-colors duration-300 flex items-center justify-center">
							<IcoInstagram />
						</a>
						<a href="#" aria-label="GitHub" class="w-[24px] h-[24px] text-[var(--color-00-orange)] hover:text-white transition-colors duration-300 flex items-center justify-center">
							<IcoGithub />
						</a>
					</div>

				</div>
				<div class="mt-4 text-[#616161] text-[13px] flex items-center gap-2 -ml-[20px]">
					<div class="w-[5px] h-[5px] rounded-full bg-[#616161]"></div>
					<p class="m-0">&nbsp;&nbsp;Copyright &copy; {currentYear} aectronix. All rights & trademarks reserved.</p>
				</div>

			</div>

			<div class="min-[1760px]:col-span-3 grid grid-cols-1 lg:grid-cols-3 gap-10">
				
				<div class="flex flex-col gap-4 mt-[14px] lg:px-[36px]">
					<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
						EXPLORE
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
							<line x1="7" y1="7" x2="17" y2="17"></line>
							<polyline points="17 7 17 17 7 17"></polyline>
						</svg>
					</h4>
					<div class="flex flex-wrap gap-2">
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] bg-[var(--color-00-orange)] !text-[#222222] font-bold text-[13px] hover:bg-white transition-colors duration-300">/home</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#000000] text-[13px] font-medium transition-colors duration-300">/services</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/projects</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/blog</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/dev</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/about</a>
					</div>
				</div>

				<div class="flex flex-col gap-4 mt-[14px] lg:px-[36px]">
					<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
						SERVICES
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
							<line x1="7" y1="7" x2="17" y2="17"></line>
							<polyline points="17 7 17 17 7 17"></polyline>
						</svg>
					</h4>
					<div class="flex flex-wrap gap-2">
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/bim</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/cde</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/ai</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/dev</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/it</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/bi</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/3dm</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/aad</a>
					</div>
				</div>

				<div class="flex flex-col gap-4 mt-[14px] lg:px-[36px]">
					<h4 class="text-white font-bold text-[14px] flex items-center leading-none tracking-wide">
						SUPPORT
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 mt-0.5">
							<line x1="7" y1="7" x2="17" y2="17"></line>
							<polyline points="17 7 17 17 7 17"></polyline>
						</svg>
					</h4>
					<div class="flex flex-wrap gap-2">
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/privacy policy</a>
						<a href="#" class="h-[24px] inline-flex items-center px-3 rounded-[4px] border border-[#777777] !text-[#F2F3F8] hover:bg-[var(--color-00-orange)] hover:border-[var(--color-00-orange)] hover:!text-[#222222] text-[13px] font-medium transition-colors duration-300">/cookies</a>
					</div>
				</div>

			</div>

		</div>
	</div>
</footer>