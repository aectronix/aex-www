</footer>

<script define:vars={{ NAV_IDLE, NAV_ACTIVE }}>
	// Refine the build-time highlighting with the hash, which the server never
	// sees. Highlights BOTH the plain page link for the current path AND the
	// exact section link when the hash matches one, so e.g. /services#3dm
	// lights up /services and /3dm together.
	(function () {
		const links = Array.from(document.querySelectorAll('[data-nav]'));
		if (!links.length) return;

		const norm = (href) => {
			const u = new URL(href, location.origin);
			const p = u.pathname.replace(/\/+$/, '') || '/';
			return p + u.hash;
		};

		function sync() {
			const path = location.pathname.replace(/\/+$/, '') || '/';
			const here = path + location.hash;
			// the exact section link (path + hash), when the hash matches one
			const exact = links.find((a) => norm(a.getAttribute('href')) === here);
			// AND the plain page link for the current path, so /services stays
			// highlighted while you are on /services#3dm
			const page = links.find((a) => norm(a.getAttribute('href')) === path);
			for (const a of links) {
				a.className = (a === exact || a === page) ? NAV_ACTIVE : NAV_IDLE;
			}
		}

		sync();
		window.addEventListener('hashchange', sync);
	})();
</script>