---
// src/components/block_footer.astro
import Logo from './aex_logo_bo.astro';
import LogoText from './aex_logo_text.astro';
import IcoLinkedin from './item_ico_linkedin.astro';
import IcoInstagram from './item_ico_instagram.astro';
import IcoGithub from './item_ico_github.astro';

const currentYear = new Date().getFullYear();

// --- active nav link -------------------------------------------------------
// The PATH is known at build time, so plain page links (/services, /about) are
// highlighted server-side with no JS. The HASH is never sent to the server, so
// links like /services#bim are resolved by the small script at the bottom,
// which also re-runs on hashchange. Without JS you still get correct
// page-level highlighting.
const NAV_BASE = "h-[24px] inline-flex items-center px-3 pt-[2px] rounded-[4px] text-[13px] transition-colors duration-300";
const NAV_IDLE   = `${NAV_BASE} border border-[#777777] !text-[#F2F3F8] font-medium hover:bg-[#FF8C00] hover:border-[#FF8C00] hover:!text-[#222222]`;
const NAV_ACTIVE = `${NAV_BASE} border border-[#FF8C00] bg-[#FF8C00] !text-[#222222] font-bold`;

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';

function navClass(href: string) {
	const path = (href.split('#')[0] || '/').replace(/\/+$/, '') || '/';
	// only hash-free links can be resolved at build time
	return (!href.includes('#') && path === here) ? NAV_ACTIVE : NAV_IDLE;
}
---

