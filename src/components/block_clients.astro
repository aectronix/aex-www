---
// src/components/block_clients.astro

import LogoARM from	'../components/client_logo_arm.astro'
import LogoMMK from	'../components/client_logo_mmk.astro'
import LogoPRJ from	'../components/client_logo_prj.astro'
import LogoSWA from	'../components/client_logo_swa.astro'

---

<section class="clients">
	<div class="clients__inner container">

		<div class="split-layout">
			
			<div class="split-layout__sidebar">
				<div class="section-intro section-intro--clients">
					<div class="section-intro__line"></div>
					<h2 class="section-intro__title">Our Clients</h2>
					<p class="section-intro__text">
						Companies we're happy to work with.
					</p>
				</div>
			</div>

			<div class="split-layout__content">
				<div class="clients__list">
					<span class="clients__logo clients__logo--sm"><LogoPRJ /></span>
					<span class="clients__logo"><LogoMMK /></span>
					<span class="clients__logo clients__logo--sm"><LogoSWA /></span>
					<span class="clients__logo"><LogoARM /></span>
				</div>
			</div>

		</div>

	</div>
</section>