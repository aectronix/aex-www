					<button type="button" data-next class="flex justify-center items-center leading-none w-[40px] h-[24px] border border-[#E3E5EA] bg-transparent text-black text-[15px] rounded-[5px] transition-colors duration-300 hover:border-black hover:bg-black hover:text-white cursor-pointer disabled:opacity-40 disabled:pointer-events-none" aria-label="Next slide">&rarr;</button>
				</div>
			</div>

		</div>
	</div>
</section>

<script>
	// Slider: one card per click, stop + disable arrows at the ends.
	// Sizing matches the ORIGINAL card exactly: the flex item (the slide, which
	// carries px-5) ranges 340..400px — same as the original
	// `flex-[1_1_340px] max-w-[400px]`. The px-5 lives INSIDE that box, so the
	// grey card is slide - 40px, exactly as before.
	//   - perView = most 340px boxes that fit (rounded DOWN); never below 340,
	//     never overflow.
	//   - boxes grow to fill, capped at 400px.
	//   - leftover space is split as symmetric side margin (safe-spots) so
	//     nothing clips at the transition widths.
	const BOX_MIN = 340;    // slide (flex item) min — matches flex-[1_1_340px]
	const BOX_MAX = 400;    // slide max — matches max-w-[400px]
	const MAX_PER_VIEW = 3; // never show more than 3 cards at once
	const AUTOPLAY_MS = 5000; // idle time before auto-sliding one full page

	function initServicesSlider(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-track]');
		const viewport = root.querySelector<HTMLElement>('[data-slider]');
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
		const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
		if (!track || !viewport || !slides.length || !prevBtn || !nextBtn) return;

		// progress indicator: one slash per card (optional element)
		const FILLED = '#FF8C00';
		const EMPTY = '#cccccc';
		const indicator = root.querySelector<HTMLElement>('[data-indicator]');
		// slashes live in their own sub-container so a static label (e.g. "SRV")
		// in the indicator isn't wiped when we (re)build the marks
		const marksBox = root.querySelector<HTMLElement>('[data-indicator-marks]') ?? indicator;
		const countEl = root.querySelector<HTMLElement>('[data-indicator-count]');
		const marks: HTMLElement[] = [];
		if (marksBox) {
			marksBox.textContent = '';
			for (let i = 0; i < slides.length; i++) {
				const m = document.createElement('span');
				m.textContent = '/';
				m.style.color = EMPTY;
				marksBox.appendChild(m);
				marks.push(m);
			}
		}

		function paintIndicator() {
			// orange = cards on screen or already slid past = index + perView
			const filled = Math.min(slides.length, index + perView);
			for (let i = 0; i < marks.length; i++) {
				marks[i].style.color = i < filled ? FILLED : EMPTY;
			}
			// running count of seen cards, zero-padded to 2 digits (e.g. 03)
			if (countEl) countEl.textContent = String(filled).padStart(2, '0');
		}

		let index = 0;
		let perView = 1;
		let box = BOX_MIN;  // slide box width incl. padding == the translate step
		let padLeft = 0;    // leftover space, split so the window is centered

		function layout() {
			const vw = viewport.clientWidth;
			// perView = most boxes that fit at MIN width (rounded DOWN), so a
			// card is never forced below 340px and n boxes never overflow vw.
			let n = Math.floor(vw / BOX_MIN);
			n = Math.max(1, Math.min(MAX_PER_VIEW, n, slides.length));
			// grow each box to fill, capped at MAX so the grey card <= 400px
			let b = Math.max(BOX_MIN, Math.min(BOX_MAX, vw / n));
			// any remaining space becomes symmetric margin (centered window),
			// which keeps cards from ever clipping in the transition widths
			const leftover = Math.max(0, vw - n * b);

			perView = n;
			box = b;
			padLeft = leftover / 2;

			for (const s of slides) {
				s.style.flex = `0 0 ${b}px`;
				s.style.width = `${b}px`;
				s.style.maxWidth = `${b}px`;
			}
		}

		function maxIndex() {
			return Math.max(0, slides.length - perView);
		}

		function apply() {
			const max = maxIndex();
			index = Math.min(Math.max(index, 0), max);
			// start the visible window at padLeft, then step by whole boxes
			const x = padLeft - index * box;
			track.style.transform = `translate3d(${x}px, 0, 0)`;
			prevBtn.disabled = index <= 0;
			nextBtn.disabled = index >= max;
			paintIndicator();
		}

		function update() { layout(); apply(); }

		// --- autoplay: after AUTOPLAY_MS with no arrow clicks, advance by a
		// full page (perView cards). Manual clicks restart the idle countdown.
		// Auto-advance WRAPS to the start when it reaches the end (manual
		// arrows still stop and disable at the ends, as before).
		let autoTimer = 0;
		let hovered = false;
		const reducedMotion = !!(window.matchMedia
			&& window.matchMedia('(prefers-reduced-motion: reduce)').matches);

		function autoAdvance() {
			const max = maxIndex();
			if (max <= 0) return; // all cards visible: nothing to slide
			index = index >= max ? 0 : Math.min(index + perView, max);
			apply();
		}

		function stopAutoplay() {
			if (autoTimer) { clearInterval(autoTimer); autoTimer = 0; }
		}

		function startAutoplay() {
			stopAutoplay();
			if (reducedMotion) return; // respect the OS motion preference
			autoTimer = window.setInterval(() => {
				// skip ticks while the person is reading a card or the tab is
				// in the background; resume naturally on the next tick
				if (hovered || document.hidden) return;
				autoAdvance();
			}, AUTOPLAY_MS);
		}

		viewport.addEventListener('mouseenter', () => { hovered = true; });
		viewport.addEventListener('mouseleave', () => { hovered = false; });

		prevBtn.addEventListener('click', () => { index -= 1; apply(); startAutoplay(); });
		nextBtn.addEventListener('click', () => { index += 1; apply(); startAutoplay(); });

		// Observe the VIEWPORT itself, not just window resize. Its width is
		// driven by the group's own breakpoints + flex, which can settle after
		// load; ResizeObserver fires on the post-layout box, so clientWidth is
		// always the real one. rAF coalesces bursts.
		let raf = 0;
		const schedule = () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(update);
		};
		if (typeof ResizeObserver !== 'undefined') {
			new ResizeObserver(schedule).observe(viewport);
		} else {
			window.addEventListener('resize', schedule);
		}
		// also recompute once assets/fonts settle, in case initial read was early
		window.addEventListener('load', schedule);

		update();
		startAutoplay();
	}

	document.querySelectorAll<HTMLElement>('[data-slider]').forEach((el) => {
		const groupEl = (el.closest('.flex-wrap') as HTMLElement) ?? el.parentElement!;
		initServicesSlider(groupEl);
	});
</script>