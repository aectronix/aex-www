---
// src/components/block_services.astro
import ItemArrow from './item_arrow.astro';
---

<section class="relative mt-10 md:mt-25 lg:mt-40 px-5">
	<div class="mx-auto flex flex-wrap justify-center gap-y-[40px] w-full max-w-[1600px]">

		<div class="p-5 min-[1420px]:h-[240px] self-start
		            flex-[1_1_100%] max-w-[400px]
		            min-[720px]:max-w-[800px]
		            min-[1080px]:max-w-[1200px]
		            min-[1420px]:flex-[1_1_340px] min-[1420px]:max-w-[400px]">
			<h3 class="relative py-1 font-bold text-[24px] text-[#222222]">
				<span class="absolute -top-[20px] left-0 w-[40px] h-[10px] bg-[#FF8C00]"></span>
				OUR SERVICES
			</h3>
			<p class="text-[16px] pt-5 text-black leading-[1.25]">
				We could provide a wide range of BIM, VDC, IT and other digital services to satisfy client any needs and goals.
			</p>
			<a href="#" aria-label="See all services" class="mt-5 group inline-flex items-center gap-1.5
															min-[1420px]:absolute
															min-[1420px]:top-42">
				<span class="flex justify-center items-center leading-none w-[40px] h-[24px] rounded-[5px] border border-black bg-black text-white text-[15px] transition-colors duration-300 group-hover:bg-[#FF8C00] group-hover:border-[#FF8C00] group-hover:text-black">
					&rarr;
				</span>
				<span class="inline-flex items-center justify-center px-3 h-[24px] rounded-[5px] border border-black bg-transparent text-black text-[12px] transition-colors duration-300 group-hover:bg-black group-hover:text-white">
					&gt; see all_
				</span>
			</a>
		</div>

		<!-- CARD GROUP: same responsive width steps as before; now a slider.
		     min-w-0 is REQUIRED: without it, the non-wrapping track's content
		     (5 cards) forces this flex item's min-width to its content size,
		     so the group balloons past the container and the first card clips
		     at the left edge. min-w-0 lets it shrink to the available width. -->
		<div class="flex flex-wrap gap-y-[40px] min-w-0
		            flex-[1_1_100%] max-w-[400px]
		            min-[720px]:max-w-[800px]
		            min-[1080px]:max-w-[1200px]
		            min-[1420px]:flex-[3_3_1020px] min-[1420px]:max-w-[1200px]">

			<!-- viewport: clips the track; width comes from the group's flex sizing above.
			     min-w-0 here too, so the overflow-hidden viewport can shrink below its
			     track's content width instead of being pushed wide by it. -->
			<div class="services-slider w-full min-w-0 overflow-hidden" data-slider>
				<!-- track: single non-wrapping row. NO x-gap: the 40px gutter between
				     cards comes from each slide's own px-5 padding, exactly like the
				     original wrapping layout. -->
				<div class="flex flex-nowrap gap-y-[40px] transition-transform duration-300 ease-out will-change-transform"
				     data-track>

					<!-- SLIDE 1 -->
					<div class="shrink-0 px-5 h-[240px] text-[#222222]" data-slide>
						<article class="group relative flex flex-col items-start w-full h-[240px] rounded-[24px] px-8 py-7 bg-[#E3E5EA]">
							<div class="absolute inset-0 rounded-[24px] bg-[#FF8C00] opacity-0 transition-opacity duration-300 group-hover:opacity-100 z-0"></div>
							<div class="relative flex flex-row gap-2 mb-4 z-10">
								<div class="inline-flex items-center bg-black text-white text-[15px] font-bold px-4 h-[30px] rounded-full">BIM</div>
							</div>
							<div class="relative flex-1 w-full z-10 flex flex-col">
								<div class="relative w-full flex-1">
									<h3 class="py-2.5 absolute inset-0 text-[28px] font-extrabold text-[#222222] leading-[1.1] transition-opacity duration-300 opacity-100 group-hover:opacity-0 pointer-events-none">
										BIM Management & Coordination 2
									</h3>
									<p class="py-3 absolute inset-0 text-[16px] font-medium text-[#222222] leading-[1.25] transition-opacity duration-300 opacity-0 group-hover:opacity-100 pointer-events-none pr-8">
										We support ongoing projects by establishing and maintaining digital collaborative workflows among involved parties.
									</p>
								</div>
								<a href="#" class="inline-flex items-center bg-black text-white text-[12px] px-3 w-[80px] h-[24px] rounded-[5px] mt-auto z-10 self-start">
									<span class="block group-hover:hidden">&gt; details_&nbsp;</span>
									<span class="hidden group-hover:block">&gt; explore_</span>
								</a>
							</div>
							<div class="absolute bottom-0 right-0 w-[50px] h-[50px] bg-[var(--set0-grey-0)] rounded-tl-[30px] rounded-br-[24px] flex items-end justify-end
										before:content-[''] before:absolute before:w-[20px] before:h-[20px] before:bottom-[100%] before:right-0 before:bg-[radial-gradient(circle_at_top_left,transparent_20px,var(--set0-grey-0)_20px)]
										after:content-[''] after:absolute after:w-[20px] after:h-[20px] after:right-[100%] after:bottom-0 after:bg-[radial-gradient(circle_at_top_left,transparent_20px,var(--set0-grey-0)_20px)]
										z-10">
								<button class="relative flex items-center justify-center w-[40px] h-[40px] bg-black text-white rounded-full transition-colors duration-300 group-hover:bg-[#FF8C00] group-hover:text-black" aria-label="Explore">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="7" y1="17" x2="17" y2="7"></line>
										<polyline points="7 7 17 7 17 17"></polyline>
									</svg>
								</button>
							</div>
