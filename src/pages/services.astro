---
import 					'../styles/global.css';
import { Image } from		'astro:assets';
import HeroImage from		'../assets/aex_hero_cover.png';

import Services from		'../components/block_services.astro';
import Projects from		'../components/block_projects.astro';
import Clients from			'../components/block_clients.astro';
import Footer from			'../components/block_footer.astro';

import Logo from 			'../components/aex_logo.astro';
import LogoText from		'../components/aex_logo_text.astro';
import ItemMenu from		'../components/item_menu.astro';
import ItemArrow from		'../components/item_arrow.astro';

const pageTitle = "aectronix";
---

<html lang="en" class="www">

	<head>
		<title>{pageTitle}</title>
		<meta charset="utf-8" />
		<meta name="description" content="aectronix – we provide bim, vdc and digitalization to aeco sector" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>

	<body class="bg-[#f2f3f5]">

<header class="relative px-5">
    <div class="mx-auto flex w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px] items-center p-5 pb-8 md:pt-[50px] md:pb-[60px]">
        
        <a href="/" class="flex flex-nowrap items-center gap-x-[30px] shrink-0 no-underline" aria-label="aectronix home">
            <Logo />
            <div class="hidden lg:block m-0 -translate-y-[2px]">
                <LogoText />
            </div>
        </a>
        
        <nav class="ml-auto">
            <ul class="hidden md:flex m-0 p-0 list-none gap-x-[50px]">
                <li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
                    <a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/">home</a>
                </li>
                <li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
                    <a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/services">services</a>
                </li>
                <li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
                    <a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/about">about</a>
                </li>
<!--                 <li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
                    <a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="#">blog</a>
                </li> -->
                <li class="text-[#aaa] flex items-center text-[20px] font-semibold before:content-['>'] before:mr-1">
                    <span class="text-[#aaa]" href="#">en</span>
                </li>
            </ul>
            <button type="button" class="block md:hidden" aria-label="Open menu">
                <ItemMenu />
            </button>
        </nav>

    </div>
</header>

		<main>

			<section class="relative px-5 ">

			    <div class="relative mx-auto flex w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px] rounded-[24px]">
			            
			            <div class="p-5 relative z-10 self-start w-full max-w-[450px] md:max-w-[600px] lg:max-w-[750px]">
			                
			                <h1 class="w-full text-[38px] md:text-[54px] lg:text-[72px] font-bold leading-[1.05] tracking-tight text-black m-0">
			                    Services
			                </h1>

			                <p class="inlinew-full max-w-[360px] min-[1200px]:max-w-[720px] text-black text-[17px] md:text-[20px] leading-[1.5] mt-10">
			                    Utilizing BIM, VDC and digital approach, we help to transform<br class="hidden min-[1200px]:block" /> AECO sector for better efficiency &amp; outcomes.
			                </p>

			            </div>

			    </div>				

			</section>

<section class="relative mt-10 px-5">
	<div class="mx-auto w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px]">

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">01</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="bim" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				BIM Management &amp; Coordination
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">bim</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># eir</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># bep</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># qa</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># iso</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># strategy</span>
			</div>

			<!-- BODY: row 3 when narrow; cols 2-4 row 2 when wide -->
			<div class="col-span-2 row-start-3 px-5 pt-8
			            min-[1420px]:col-span-3 min-[1420px]:col-start-2 min-[1420px]:row-start-2
			            min-[1420px]:pt-8
			            flex flex-col gap-5">
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We see BIM as a controlled process, guided by your company standards, your client's requirements and common sense. Today the field is crowded with standards, methods, trends and hype. We help you find your way through it, set aside what doesn't serve your goals, and define what is truly needed for every project and every stage, so the process stays focused on what really matters.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We help your team reach and maintain the quality level the project requires through agreed modelling rules, regular checks and clear feedback [, so models and drawings become a reliable source of truth]. We also help establish an effective information workflow among all parties involved, so everyone shares the same up-to-date picture of the project and information keeps its value as the project moves from design to construction and through to handover.
				</p>
			</div>

		</article>

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">02</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="3dm" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				BIM Modeling &amp; Support
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">bim</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># leadership</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># 3dm</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># revit</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># archicad</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># rhino</span>
			</div>

			<!-- BODY: row 3 when narrow; cols 2-4 row 2 when wide -->
			<div class="col-span-2 row-start-3 px-5 pt-8
			            min-[1420px]:col-span-3 min-[1420px]:col-start-2 min-[1420px]:row-start-2
			            min-[1420px]:pt-8
			            flex flex-col gap-5">
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We put together a modelling team around the actual scope of work and your needs, with the disciplines, expertise and team size the task really requires. We cover architecture, structure, MEP, landscape and other disciplines, working in the key platforms used across the industry, including Revit, Archicad and Rhino and other software.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					The team can work within our own BIM management and coordination, or join your project as support, following your leadership, standards and ways of working. We can also provide the content that modelling relies on, such as families, library objects and templates, built to your standards and ready to use.
				</p>
			</div>

		</article>

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">03</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="cde" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				CDE Deployment &amp; Support
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">cde</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># 19650</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># storage</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># backup</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># governance</span>

			</div>

			<!-- BODY: row 3 when narrow; cols 2-4 row 2 when wide -->
			<div class="col-span-2 row-start-3 px-5 pt-8
			            min-[1420px]:col-span-3 min-[1420px]:col-start-2 min-[1420px]:row-start-2
			            min-[1420px]:pt-8
			            flex flex-col gap-5">
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					A common data environment is where project information lives, and the way it is set up determines how well every party can work with it. We help you choose and deploy the platform that fits your projects, whether server-based or cloud, such as Autodesk Forma, Catenda Hub, Speckle or similar solutions, and integrate it into the way your teams and partners already work, giving everyone involved one shared digital workflow.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					Beyond the platform itself, we help set up data management and governance: clear rules for how information is organised, shared, approved and kept up to date. These rules follow your company standards, your client's requirements, alongside with ISO 19650 series.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					The value of a CDE depends on the quality and consistency of what it holds. We help keep it at an effective level through regular reviews, maintenance and user support, so it remains the place where everyone finds current, reliable information.
				</p>
			</div>

		</article>

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">04</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="dev" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				Automation & Development
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">dev</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># rpa</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># scripts</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># addins</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># integrations</span>
			</div>

			<!-- BODY: row 3 when narrow; cols 2-4 row 2 when wide -->
			<div class="col-span-2 row-start-3 px-5 pt-8
			            min-[1420px]:col-span-3 min-[1420px]:col-start-2 min-[1420px]:row-start-2
			            min-[1420px]:pt-8
			            flex flex-col gap-5">
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We automate routine wherever it brings a real gain, so your specialists spend their time on decisions and expertise rather than repetition. The result is faster and more consistent output across design and business processes, with fewer manual errors and higher productivity for everyone involved.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					To achieve this, we develop custom tools, integrations and add-ins for key platforms such as Revit, Archicad, Speckle and make effective use of visual programming with Dynamo and Grasshopper. In AECO, automation reaches far beyond single tasks: applied across design, documentation, coordination and business workflows, it can make entire processes leaner and more effective.
				</p>
			</div>

		</article>

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">05</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="ai" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				AI Workflows & Orchestration
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">ai</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># llm</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># agents</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># mcp</span>
			</div>

			<!-- BODY: row 3 when narrow; cols 2-4 row 2 when wide -->
			<div class="col-span-2 row-start-3 px-5 pt-8
			            min-[1420px]:col-span-3 min-[1420px]:col-start-2 min-[1420px]:row-start-2
			            min-[1420px]:pt-8
			            flex flex-col gap-5">
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We approach AI as a practical tool rather than a trend, and bring it into your workflows where it adds real value. This includes model intelligence, which makes the information inside BIM models easier to query, understand and use; analysis of project and company data to support better decisions; and specialised AI agents that take on defined tasks within your design, coordination and business processes.
				</p>
				<p class="text-[16px] text-[#222222] leading-[1.35]">
					We orchestrate these elements into connected workflows that work with your existing platforms and data, with clear checkpoints where your specialists review and decide. Alongside the technology, we help set the rules for how AI is used in your company: which tools are approved, how data is protected and how teams are trained, so AI becomes a reliable part of everyday work.
				</p>
			</div>

		</article>

		<article class="grid
		                grid-cols-[auto_1fr]
		                min-[1420px]:grid-cols-4
		                py-12 min-[1420px]:py-16
		                border-t border-[#E3E5EA] first:border-t-0">
			<!-- NUMBER -->
			<div class="col-start-1 row-start-1 self-start px-5
			            font-extrabold text-[#222222]
			            text-[32px] min-[1420px]:text-[40px] leading-none tracking-tight">
				<span class="font-mono">06</span><span class="text-[#FF8C00]"> /</span>
			</div>

			<!-- TITLE: beside the number when narrow; cols 2-4 when wide -->
			<h2 id="bi" class="col-start-2 row-start-1 self-start px-5
			           min-[1420px]:col-span-3
			           font-extrabold text-[#222222] leading-[1.05] tracking-tight
			           text-[32px] min-[1420px]:text-[44px]">
				Business Intelligence
			</h2>

			<!-- LABELS: full-width row 2 when narrow; under the number when wide -->
			<div class="col-span-2 row-start-2 self-start px-5 pt-6
			            min-[1420px]:col-span-1 min-[1420px]:col-start-1 min-[1420px]:row-start-2
			            min-[1420px]:pt-8 min-[1420px]:-mt-[2px]
			            flex flex-wrap items-center gap-2">
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             bg-black text-white text-[12px] font-bold lowercase">bi</span>
				<span class="inline-flex items-center h-[26px] px-3 rounded-[6px]
				             ring-1 ring-inset ring-[#cccccc] text-[#555555] text-[12px] font-bold lowercase
				             transition-shadow duration-300 hover:ring-black"># reports</span>
