---
import 						'../styles/global.css';

import Footer from			'../components/block_footer.astro';

import Logo from 			'../components/aex_logo.astro';
import LogoText from		'../components/aex_logo_text.astro';
import ItemMenu from		'../components/item_menu.astro';

import IcoLinkedin from 	'../components/item_ico_linkedin.astro';
import IcoGithub from 		'../components/item_ico_github.astro';

const pageTitle = "aectronix";
---

<html lang="en" class="www">

	<head>
		<title>{pageTitle}</title>
		<meta charset="utf-8" />
		<meta name="description" content="aectronix – we provide bim, vdc and digitalization to aeco sector" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>

	<body class="bg-[#f2f3f5]">

<header class="relative px-5">
	<div class="mx-auto flex w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px] items-center p-5 pb-8 md:pt-[50px] md:pb-[60px]">

		<a href="/" class="flex flex-nowrap items-center gap-x-[30px] shrink-0 no-underline" aria-label="aectronix home">
			<Logo />
			<div class="hidden lg:block m-0 -translate-y-[2px]">
				<LogoText />
			</div>
		</a>

		<nav class="ml-auto">
			<ul class="hidden md:flex m-0 p-0 list-none gap-x-[50px]">
				<li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
					<a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/">home</a>
				</li>
				<li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
					<a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/services">services</a>
				</li>
				<li class="flex items-center text-[20px] font-semibold before:content-['/'] before:mr-1">
					<a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="/about">about</a>
				</li>
				<li class="flex items-center text-[20px] font-semibold before:content-['>'] before:mr-1">
					<a class="hover:text-[#ff861b] hover:underline transition-colors duration-200 text-black" href="#">en</a>
				</li>
			</ul>
			<button type="button" class="block md:hidden" aria-label="Open menu">
				<ItemMenu />
			</button>
		</nav>

	</div>
</header>

		<main>

			<!-- HERO -->
			<section class="relative px-5 ">
				<div class="relative mx-auto flex w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px] rounded-[24px]">
					<div class="p-5 relative z-10 self-start w-full">

						<h1 class="w-full text-[38px] md:text-[54px] lg:text-[72px] font-bold leading-[1.05] tracking-tight text-black m-0">
							About Us
						</h1>

						<div class="flex flex-col gap-5 mt-10 max-w-[1100px]">
							<p class="text-black text-[16px] md:text-[17px] leading-[1.45]">
								We are the compact Ukrainian team of BIM/VDC and digitization specialists in the field of design and construction, with a solid experience in diverse projects &ndash; including massive shopping malls, large-scale residential complexes, offices, business centers, schools, and industrial facilities.
							</p>
							<p class="text-black text-[16px] md:text-[17px] leading-[1.45]">
								Having worked for and with the top AEC companies in Ukraine, Poland, Germany, the US and other countries, we&rsquo;ve contributed to establishing digital workflows that enhance project efficiency, productivity, and the quality of built assets. Now, we&rsquo;ve come together to harness our collective experience, knowledge, and skills, forging a path toward new goals and opportunities.
							</p>
						</div>

					</div>
				</div>
			</section>

			<!-- OUR TEAM: info block + wrapping card grid (same pattern as the index page) -->
			<section class="relative mt-20  px-5">
				<div class="mx-auto flex flex-wrap justify-center gap-y-[40px] w-full max-w-[400px] min-[720px]:max-w-[800px] min-[1080px]:max-w-[1200px] min-[1420px]:max-w-[1600px]">

					<!-- INFO: full row above the cards until 1420px, then a left column -->
					<div class="p-5 self-start
					            flex-[1_1_100%] max-w-[400px]
					            min-[720px]:max-w-[800px]
					            min-[1080px]:max-w-[1200px]
					            min-[1420px]:flex-[1_1_340px] min-[1420px]:max-w-[400px]">
						<h3 class="relative py-1 font-bold text-[24px] text-[#222222]">
							<span class="absolute -top-[20px] left-0 w-[40px] h-[10px] bg-[#FF8C00]"></span>
							OUR TEAM
						</h3>
						<p class="text-[16px] pt-5 text-black leading-[1.25]">
							We could provide a wide range of BIM, VDC, IT and other digital services to satisfy client any needs and goals.
						</p>
					</div>

					<!-- CARDS: wrap one-by-one; 1 / 2 / 3 per row on the usual ladder -->
					<div class="flex flex-wrap items-stretch gap-y-[40px] min-w-0
					            flex-[1_1_100%] max-w-[400px]
					            min-[720px]:max-w-[800px]
					            min-[1080px]:max-w-[1200px]
